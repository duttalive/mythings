{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mythings",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// These are the hosted instance's settings. To deploy your own, change the
	// route, database_id, APP_ORIGIN, MAIL_FROM and VAPID_SUBJECT (README →
	// "Deploy your own"), and the wss:// origin in public/_headers.
	// Production lives at https://mythings.dynocoder.com only.
	"routes": [{ "pattern": "mythings.dynocoder.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mythings",
			"database_id": "1c8de81b-5a0e-4edd-beaa-94f3ed8b7121",
			"migrations_dir": "worker/db/migrations"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "USER_STORE", "class_name": "UserStore" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserStore"] }],
	// Per-key limits for unauthenticated endpoints (the key is IP, or IP + email).
	"ratelimits": [
		{
			"name": "LOGIN_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "SIGNUP_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "RESET_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 3, "period": 60 }
		}
	],
	// Password reset emails (Cloudflare Email Sending; dynocoder.com is onboarded).
	"send_email": [{ "name": "EMAIL" }],
	"vars": {
		// Links in emails and the CSRF check use this. .dev.vars overrides it locally.
		"APP_ORIGIN": "https://mythings.dynocoder.com",
		// "password" (built-in accounts) or "access" (behind Cloudflare Access)
		"AUTH_MODE": "password",
		// "true": anyone can create an account (the hosted instance is open to all).
		"SIGNUPS_OPEN": "true",
		// Only used when AUTH_MODE is "access", e.g. "myteam.cloudflareaccess.com"
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": "",
		// Contact for push services (mailto: or https:). Keys are secrets:
		// VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY (see scripts/vapid-keys.mjs).
		"VAPID_SUBJECT": "mailto:dutta@dynocoder.com",
		// Sender of account emails.
		"MAIL_FROM": "dutta@dynocoder.com",
		// "true" only in local development (.dev.vars): keep emails in memory, shown at /api/dev/mail.
		"DEV_MAILBOX": "false"
	},
	"observability": { "enabled": true }
}
