{
	"name": "mythings",
	"private": true,
	"description": "A calm, fast, local-first to-do app that works offline and syncs in real time, on Cloudflare Workers.",
	"license": "AGPL-3.0-only",
	"homepage": "https://mythings.dynocoder.com",
	"repository": "github:duttalive/mythings",
	"version": "1.4.0",
	"type": "module",
	"packageManager": "pnpm@10.34.8",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "corepack pnpm build && vite preview",
		"deploy": "corepack pnpm build && wrangler d1 migrations apply mythings --remote && wrangler deploy",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"cf-typegen": "wrangler types --strict-vars=false worker/worker-configuration.d.ts",
		"db:migrate:local": "wrangler d1 migrations apply mythings --local",
		"db:migrate:remote": "wrangler d1 migrations apply mythings --remote",
		"vapid": "node scripts/vapid-keys.mjs",
		"e2e": "playwright test",
		"release": "node scripts/release.mjs",
		"ship": "corepack pnpm release && corepack pnpm run deploy && git push --follow-tags"
	},
	"dependencies": {
		"@block65/webcrypto-web-push": "^2.0.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/lexend": "^5.3.0",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@tanstack/react-router": "1.170.44",
		"chrono-node": "^2.10.3",
		"dexie": "^4.4.7",
		"dexie-react-hooks": "^4.4.0",
		"fractional-indexing": "^4.0.0",
		"hono": "^4.13.14",
		"jose": "^6.2.13",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"ulid": "^3.0.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@cloudflare/vite-plugin": "^1.65.0",
		"@cloudflare/vitest-plugin": "^1.4.7",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vitejs/plugin-react": "^6.1.2",
		"axe-core": "^4.14.0",
		"fake-indexeddb": "^6.2.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.5",
		"workbox-build": "^7.4.1",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.152.0"
	}
}
